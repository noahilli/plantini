{
  "kind": "collectionType",
  "collectionName": "quizzes",
  "info": {
    "singularName": "quiz",
    "pluralName": "quizzes",
    "displayName": "Quiz"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "publicId": { "type": "string", "required": true, "unique": true },
    "slug": { "type": "string", "required": true, "unique": true },
    "releaseVersion": { "type": "string", "required": true },
    "generatedFromBlueprint": { "type": "string", "private": true },
    "generationFingerprint": { "type": "string", "private": true },
    "contentVersion": { "type": "string", "required": true },
    "title": {
      "type": "string",
      "required": true
    },
    "quizType": {
      "type": "enumeration",
      "enum": [
        "multiple-choice",
        "flashcard",
        "identification",
        "feature-match"
      ]
    },
    "data": {
      "type": "json"
    },
    "level": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::level.level",
      "inversedBy": "quizzes"
    },
    "plant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::plant.plant"
    },
    "reviewStatus": {
      "type": "enumeration",
      "enum": [
        "draft",
        "pending_review",
        "approved",
        "rejected"
      ],
      "default": "draft"
    }
  }
}
