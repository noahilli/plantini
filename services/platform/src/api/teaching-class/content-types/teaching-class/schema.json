{
  "kind": "collectionType",
  "collectionName": "teaching_classes",
  "info": { "singularName": "teaching-class", "pluralName": "teaching-classes", "displayName": "Teaching Class" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "publicId": { "type": "string", "required": true, "unique": true },
    "ownerSubject": { "type": "string", "required": true, "private": true },
    "name": { "type": "string", "required": true, "maxLength": 100 },
    "description": { "type": "text", "maxLength": 1000 },
    "students": { "type": "relation", "relation": "oneToMany", "target": "api::teaching-student.teaching-student", "mappedBy": "classroom" }
  }
}
