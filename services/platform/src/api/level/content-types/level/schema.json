{
  "kind": "collectionType",
  "collectionName": "levels",
  "info": {
    "singularName": "level",
    "pluralName": "levels",
    "displayName": "Level"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "publicId": { "type": "string", "required": true, "unique": true },
    "slug": { "type": "string", "required": true, "unique": true },
    "releaseVersion": { "type": "string", "required": true },
    "title": { "type": "string", "required": true },
    "levelNumber": { "type": "integer", "required": true },
    "sequence": { "type": "integer", "required": true },
    "difficulty": { "type": "string" },
    "learningGoal": { "type": "text" },
    "completionRule": { "type": "json", "required": true },
    "plants": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::plant.plant",
      "inversedBy": "levels"
    },
    "quizzes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::quiz.quiz",
      "mappedBy": "level"
    },
    "ecosystem": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::ecosystem.ecosystem",
      "inversedBy": "levels"
    }
  }
}
