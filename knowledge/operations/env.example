# Copy to .env; never commit .env. Replace every placeholder with a local random value.
POSTGRES_VERSION=<pin-compatible-version>
REDIS_VERSION=<pin-compatible-version>
MINIO_VERSION=<pin-compatible-version>
MAILPIT_VERSION=<pin-compatible-version>
MOCKSERVER_VERSION=<pin-compatible-version>
KEYCLOAK_VERSION=<pin-compatible-version>
PLAYWRIGHT_IMAGE_TAG=<pin-compatible-version>

PLATFORM_DB_PASSWORD=<generate-local-random-secret>
KEYCLOAK_DB_PASSWORD=<generate-local-random-secret>
KEYCLOAK_BOOTSTRAP_ADMIN=plantini-local-admin
KEYCLOAK_BOOTSTRAP_PASSWORD=<generate-local-random-secret>
MINIO_ROOT_USER=plantini-local
MINIO_ROOT_PASSWORD=<generate-local-random-secret>

STRAPI_APP_KEYS=<generate-comma-separated-local-keys>
STRAPI_API_TOKEN_SALT=<generate-local-random-secret>
STRAPI_ADMIN_JWT_SECRET=<generate-local-random-secret>
STRAPI_TRANSFER_TOKEN_SALT=<generate-local-random-secret>
STRAPI_JWT_SECRET=<generate-local-random-secret>

# Real provider secrets belong only in approved secret management.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
PLANTNET_API_KEY=local-mock-only
