# Plantini production edge. TLS certificates are issued automatically by
# Caddy (ACME HTTP-01), so the DNS records must point at this host first.
# Runs with host networking because the services bind to 127.0.0.1 only.
{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Project homepage (static container, see apps/homepage)
{$PLANTINI_DOMAIN} {
	import security_headers

	# Android test builds (APK) and their metadata live outside the repository
	# and the homepage image, in the read-only /srv/downloads mount.
	handle /download/* {
		uri strip_prefix /download
		root * /srv/downloads
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		header @apk Content-Disposition "attachment; filename=plantini.apk"
		@meta path *.json *.sha256
		header @meta Cache-Control "no-cache"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:{$HOMEPAGE_PORT:8083}
	}
}

www.{$PLANTINI_DOMAIN} {
	redir https://{$PLANTINI_DOMAIN}{uri} permanent
}

# Flutter web app
app.{$PLANTINI_DOMAIN} {
	import security_headers
	root * /srv/web
	encode zstd gzip
	@healthz path /healthz
	respond @healthz "ok" 200
	# Entry files are not content-hashed: revalidate them so a deployment is
	# picked up immediately (the service worker then updates the rest).
	@entry path / /index.html /flutter_bootstrap.js /flutter_service_worker.js /main.dart.js /version.json /manifest.json
	header @entry Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}

# Separate redaction studio; it has no direct database or Strapi-admin access.
studio.{$PLANTINI_DOMAIN} {
	import security_headers
	reverse_proxy 127.0.0.1:{$EDITOR_PORT:8084}
}

# Fach-API. Only the public API prefix is reachable: Strapi's /admin and its
# built-in /api/auth/local/register are deliberately not proxied.
api.{$PLANTINI_DOMAIN} {
	import security_headers
	encode zstd gzip
	request_body {
		max_size 22MB
	}
	handle /api/v1/* {
		reverse_proxy 127.0.0.1:1338
	}
	handle {
		respond "Not found" 404
	}
}

# Keycloak. Realm "plantini" and its assets only: no admin console, no master
# realm. Administer through an SSH tunnel to 127.0.0.1:8082.
auth.{$PLANTINI_DOMAIN} {
	import security_headers
	@public path /realms/plantini/* /resources/* /robots.txt
	handle @public {
		reverse_proxy 127.0.0.1:8082
	}
	handle {
		respond "Not found" 404
	}
}
