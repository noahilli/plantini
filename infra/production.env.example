# Use immutable references such as registry.example/plantini/platform:1.0.0@sha256:...
PLATFORM_IMAGE=
POSTGRES_IMAGE=
REDIS_IMAGE=
KEYCLOAK_IMAGE=
HOMEPAGE_IMAGE=
EDITOR_IMAGE=
TEACHER_IMAGE=

# Origin of the web app (CORS, OIDC redirects). The project homepage lives on the apex domain.
WEB_PUBLIC_URL=https://app.example.org
EDITOR_PUBLIC_URL=https://studio.example.org
TEACHER_PUBLIC_URL=https://portal.example.org
API_PUBLIC_URL=https://api.example.org
AUTH_PUBLIC_URL=https://auth.example.org
AUTH_PUBLIC_HOST=auth.example.org
API_LOOPBACK_PORT=1338
HOMEPAGE_LOOPBACK_PORT=8083
EDITOR_LOOPBACK_PORT=8084
TEACHER_LOOPBACK_PORT=8085
AUTH_LOOPBACK_PORT=8082
KEYCLOAK_REALM_FILE=./realm-production.json

# Generate unique high-entropy values and inject them through the deployment
# secret manager. Never commit the completed production environment file.
PLATFORM_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
STRAPI_APP_KEYS=
STRAPI_API_TOKEN_SALT=
STRAPI_ADMIN_JWT_SECRET=
STRAPI_TRANSFER_TOKEN_SALT=
STRAPI_JWT_SECRET=
PLANTNET_API_KEY=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# Dedicated least-privileged Keycloak service account for invitations and managed pupils.
# Assign only view-users, manage-users and view-realm on realm-management.
# Leave blank to disable invitations until configured.
PLATFORM_KEYCLOAK_ADMIN_CLIENT_ID=
PLATFORM_KEYCLOAK_ADMIN_CLIENT_SECRET=

PLANTNET_PROJECT=all
PLANTNET_LANGUAGE=de
PLANTNET_MAX_RESULTS=3
PLANTNET_DAILY_REQUEST_LIMIT=
PLANTNET_QUOTA_RESERVE=
PLANTNET_CIRCUIT_FAILURE_THRESHOLD=5
PLANTNET_CIRCUIT_COOLDOWN_MS=60000

# Synthetic demo catalogue (see compose.production.yaml) and third-party photos
# (licence review open, MEDIA-10). Default: no seed, no external photos.
PLATFORM_SEED_DEMO_CONTENT=false
PLATFORM_EXTERNAL_PLANT_PHOTOS=disabled
