{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "playwright.config.ts",
    "support/**/*.ts",
    "health/**/*.ts",
    "auth/**/*.ts",
    "cms/**/*.ts",
    "contract/**/*.ts",
    "qa/**/*.ts",
    "accessibility/**/*.ts"
  ],
  "exclude": ["node_modules/**", "playwright-report/**", "test-results/**"]
}
