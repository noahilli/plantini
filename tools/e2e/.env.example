# Every value is supplied by Dev/Staging or CI. Do not add localhost defaults,
# passwords, bearer tokens, cookies, private GPS data, or production URLs here.
PLANTINI_E2E_APP_URL=
PLANTINI_E2E_API_URL=
PLANTINI_E2E_OIDC_ISSUER_URL=
PLANTINI_E2E_READINESS_URL=
# The Plantini realm uses email addresses as user names.
E2E_USERNAME=
E2E_USER_PASSWORD=

# Force Chromium through IPv4. Map every DNS hostname used above to an IPv4
# address. Direct IPv4 URL hosts do not need an entry.
# Example: web.test=192.0.2.10,api.test=192.0.2.11,id.test=192.0.2.12
PLANTINI_E2E_IPV4_HOSTS=

# Failure artifacts stay disabled until the CI uploader can sanitize them.
PLANTINI_E2E_CAPTURE_FAILURE_ARTIFACTS=false
PLAYWRIGHT_TEST_RESULTS_DIR=test-results
PLAYWRIGHT_HTML_REPORT_DIR=playwright-report
PLAYWRIGHT_JUNIT_OUTPUT=test-results/junit.xml
